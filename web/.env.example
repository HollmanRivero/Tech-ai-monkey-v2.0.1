# ---- Database (Neon Postgres via Vercel Marketplace) ----
DATABASE_URL=postgresql://tech_ai_monkey:change-me@127.0.0.1:5432/tech_ai_monkey

# ---- Auth.js ----
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Fill in from the Google Cloud Console (OAuth client ID + client secret).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Encryption key for secrets at rest (32 bytes, base64) ----
# Protects connected-app OAuth tokens (Google, Slack) in the database.
# Generate: openssl rand -base64 32
# The older name SSN_KEK still works as a fallback.
SECRET_KEK=
SSN_KEK=

# ---- Owner access (unlimited, no paywall) ----
# Accounts with role "admin" are unlimited automatically (the first account
# ever created is promoted to admin). List extra e-mails here as a safety net.
OWNER_EMAILS=owner@example.com

# ---- Connected apps (Apps to connect) ----
# OAuth apps for the "Apps to connect" page. Register this redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/<provider>/callback
# Google falls back to AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET when left empty.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe (cards + Apple Pay + Google Pay) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs for each subscription plan (create in the Stripe dashboard)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ULTRA=price_...
STRIPE_PRICE_BOMB=price_...

# ---- PayPal ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox

# ---- App ----
NEXT_PUBLIC_APP_URL=https://tech-ai.tech

# ---- AI agent (the eve backend the web app proxies chat to) ----
# URL of the deployed agent, e.g. https://my-ai-agent.vercel.app
EVE_AGENT_URL=http://127.0.0.1:2000
# Shared secret used to sign the bearer API keys the web app mints for the
# agent. Nothing issues it Ã¢â‚¬â€ you generate it once and paste the SAME value
# into the agent's own .env (repo root) and here.
# Generate: openssl rand -hex 32
AGENT_API_KEY_SECRET=

# ---- Active AI model (shown in the banner) ----
MODEL_NAME=Monkey
MODEL_VERSION=v1

# ---- Company / legal ----
COMPANY_NAME=Salazar Rivero Smart Things
ORGANIZATION_NUMBER=933 853 195

# ---- Customer support ----
SUPPORT_EMAIL=support@tech-ai.tech
SUPPORT_WHATSAPP_URL=https://wa.me/4748904267
SUPPORT_HOURS=12:00-21:00 CET every day

# ---- Workflows: cron trigger ----
# Shared bearer token for GET /api/workflows/cron (protects the scheduler
# endpoint so only your cron job can trigger due workflows). There is no
# issuer Ã¢â‚¬â€ you make it up yourself as a long random string.
# Generate: openssl rand -hex 32
# If left empty the endpoint is UNAUTHENTICATED, so set this in production.
CRON_SECRET=

# ---- Optional paths (defaults are fine for a normal setup) ----
# Where the agent reads learned skills from.
# EVE_SKILLS_DIR=
# Where the agent writes generated files served from /api/generated.
# EVE_GENERATED_DIR=
# Where chat uploads are stored.
# EVE_UPLOADS_DIR=
# Public base URL shown in the VS Code docs snippet.
# NEXT_PUBLIC_API_BASE_URL=https://tech-ai.tech

